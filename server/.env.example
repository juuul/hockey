# Kopieer naar server/.env (niet in git, chmod 600) en vul de waarden in.

# 32 tekens; versleutelt de instellingen in de database. Ook in de wachtwoordmanager bewaren.
PB_ENCRYPTION_KEY=

# Mail via hockey@juliaan.eu (Vimexx). 465 = SSL/TLS, 587 = STARTTLS.
SMTP_HOST=web0171.zxcs.nl
SMTP_PORT=465
SMTP_USER=hockey@juliaan.eu
SMTP_PASS=
MAIL_FROM="MO11-1 Hockey <hockey@juliaan.eu>"

# Kopie van geslaagde app-mails naar Verzonden, via TLS op IMAP-poort 993.
# Opt-in op productie. Test maakt nooit verbinding met een echte mailbox.
# Host/user/wachtwoord vallen standaard terug op de SMTP-waarden hierboven.
IMAP_SENT_ENABLED=0
IMAP_HOST=
IMAP_PORT=993
# Leeg: automatisch SPECIAL-USE \\Sent zoeken, anders Sent.
IMAP_SENT_FOLDER=

# Optioneel: Google Maps Routes API, uitsluitend server-side. Geen VITE_-sleutel.
GOOGLE_MAPS_API_KEY=
